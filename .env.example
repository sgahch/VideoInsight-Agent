# Keep this true until your local downloader, ffmpeg and model keys are ready.
VIDEOINSIGHT_MOCK_MODE=true

# Runtime folders
VIDEOINSIGHT_TMP_DIR=data/tmp
VIDEOINSIGHT_RESULTS_DIR=data/results
VIDEOINSIGHT_MEDIA_DIR=media
VIDEOINSIGHT_DB_PATH=data/videoinsight.db

# Upload cap (MB). Upload endpoints are unauthenticated *unless* you set
# VIDEOINSIGHT_AUTH_TOKEN below, so this is the only thing standing between one
# request and a full disk.
VIDEOINSIGHT_MAX_UPLOAD_MB=2048

# Shared access token. UNSET BY DEFAULT: every endpoint is open, exactly as
# before — fine for 127.0.0.1, dangerous the moment you bind to 0.0.0.0.
# When set, every request except /, /static/*, /health and /auth/session must
# carry it (Authorization: Bearer <token>, X-Auth-Token: <token>, or the
# videoinsight_token cookie the web UI obtains via POST /auth/session).
# This is a single shared secret with no per-user accounts and no TLS: use it
# behind a reverse proxy or a private network, not on the open internet.
VIDEOINSIGHT_AUTH_TOKEN=

# How many analysis tasks may run at once. Bounded on purpose: each task can
# download, transcode and call ASR/LLM, so unbounded concurrency saturates the
# disk, the network and your provider quotas.
VIDEOINSIGHT_MAX_CONCURRENT_TASKS=4
# Core slots run first, then the bounded FIFO queue, then extra slots up to max.
# Raise MAX_CONCURRENT_TASKS above the core count to enable overflow execution.
VIDEOINSIGHT_TASK_CORE_WORKERS=2
VIDEOINSIGHT_TASK_QUEUE_CAPACITY=32

# Artifact reclamation. Orphaned task dirs (no DB record) and transcode
# intermediates of finished tasks are reclaimed at startup and on this interval.
# <=0 turns the periodic pass off (the startup pass always runs).
VIDEOINSIGHT_CLEANUP_INTERVAL_HOURS=6
# Drop task records older than N hours. <=0 (default) keeps history forever and
# only reclaims orphaned files — silently deleting history is worse than disk use.
VIDEOINSIGHT_TASK_RETENTION_HOURS=0

# Real download/transcription requirements
# Install ffmpeg separately and make sure ffmpeg is available on PATH.
# yt-dlp is installed by requirements.txt.

# ASR provider: paraformer or groq. No automatic cross-provider fallback.
ASR_PROVIDER=paraformer

# Groq Whisper ASR. Free-tier quotas still apply; use a Free-plan account.
GROQ_API_KEY=
# Optional HTTP/HTTPS proxy used only by Groq, not downloads or other providers.
# Use a server-accessible address; container localhost is not the Docker host.
# Keep authenticated proxy URLs private. Blank preserves system proxy settings.
GROQ_PROXY_URL=
GROQ_ASR_MODEL=whisper-large-v3-turbo
GROQ_ASR_CHUNK_SECONDS=300
GROQ_ASR_MAX_WORKERS=2
GROQ_ASR_GLOBAL_WORKERS=2
GROQ_ASR_REQUESTS_PER_MINUTE=18

# DashScope Paraformer ASR (used only when ASR_PROVIDER=paraformer)
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_ASR_MODEL=paraformer-realtime-v2
# Long audio is split and recognized concurrently; short audio stays single-pass.
# DASHSCOPE_ASR_MAX_WORKERS 控制单条长音频的并发转写片数（默认 8）。
# 提高可线性缩短长音频的 ASR 墙钟，但会撞 DashScope 限流（429/503）——代码已对
# 识别失败做退避重试；若仍频繁报错，调到 4~6 之间更稳。
DASHSCOPE_ASR_CHUNK_THRESHOLD_SECONDS=120
DASHSCOPE_ASR_CHUNK_SECONDS=120
DASHSCOPE_ASR_MAX_WORKERS=8
# Combined recognition-call limit across all concurrently analyzed videos.
DASHSCOPE_ASR_GLOBAL_WORKERS=8

# 抖音「转写」下载时请求的画质档位。转写只需要音轨，视频画质高低不影响识别质量，
# 但直接影响下载体积与耗时——默认 480p 可大幅缩短总耗时。设为 1080p 即恢复原行为。
# 注意：「下载源视频」功能恒用 1080p，不受此设置影响。
DOUYIN_AUDIO_RATIO=480p

# LLM provider. DeepSeek is OpenAI-compatible.
LLM_PROVIDER=mock
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash

# Optional account login. Set a PBKDF2 password hash to enable the login page.
VIDEOINSIGHT_AUTH_USERNAME=ynchen
VIDEOINSIGHT_AUTH_PASSWORD_HASH=
# Generate a persistent random secret for signed sessions; keep it private.
VIDEOINSIGHT_SESSION_SECRET=

# Optional: needed by platforms such as Douyin when anonymous download is blocked.
# Export cookies with a browser extension, then point this to the cookies.txt file.
# auto: show desktop QR login only with a desktop display and browser.
# import: file/text import only (recommended for remote servers).
# desktop: explicitly use a managed desktop session, e.g. a local VNC desktop.
COOKIE_LOGIN_MODE=auto
YTDLP_COOKIES_FILE=
# Easier for local personal use: reuse cookies from your local browser.
# Examples: chrome, edge, firefox, chrome:Default, edge:Default
YTDLP_COOKIES_FROM_BROWSER=

# 独立评论服务（四平台一级评论 + 子评论，无条数上限）
# Local install: python -m crawler_service.manage install
# Docker private network: http://videoinsight-comments:8090
COMMENT_CRAWLER_URL=http://127.0.0.1:8090
# 与独立服务一致的随机私密令牌；仅服务端使用
COMMENT_CRAWLER_TOKEN=
# Optional overrides; local installation fills these automatically.
COMMENT_CRAWLER_STATE=
MEDIACRAWLER_DIR=
# Empty = bundled Chromium; chrome/msedge = an installed browser, separate headless profile.
COMMENT_CRAWLER_BROWSER_CHANNEL=
